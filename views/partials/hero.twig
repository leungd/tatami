{% from 'macros/image.twig' import image %}
{% if title %}
  {# heroClasses / heroBodyClasses let a derivative overlay the body on the
     media (e.g. row-start-1 on both regions for a full-bleed video hero)
     without hand-rolling its own <header>. #}
  <header class="fluid-grid {% block heroClasses %}{% endblock %}">
    {% block heroMedia %}
      {% if featured_image %}
        {{
          image(
            featured_image,
            '100vw',
            'col-[full-start/full-end] max-h-96 w-full object-cover',
            'eager',
            'high'
          )
        }}
      {% endif %}
    {% endblock %}
    <div
      class="col-[content-start/content-end] {% block heroBodyClasses %}{% endblock %}"
    >
      {% block heroBody %}
        <p>
          {{ title }}
        </p>
      {% endblock %}
    </div>
  </header>
{% endif %}

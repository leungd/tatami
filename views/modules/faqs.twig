{#
  FAQs — the house FAQ module. One native <details> disclosure per row, so
  answers are in the HTML and work without JavaScript. The same rows feed
  the page's FAQPage schema (Tatami\Schema). Styling is per site.

  faqs — the `faqs` repeater: rows of { question (plain text), answer (WYSIWYG) }

  {% include 'modules/faqs.twig' with { faqs: post.meta('faqs') } %}
#}
{% if faqs is iterable and faqs is not empty %}
  <section class="fluid-grid" aria-labelledby="faqs-heading">
    <div class="col-[content-start/content-end]">
      <h2 id="faqs-heading">
        {{ __('Frequently Asked Questions', 'tatami') }}
      </h2>
      {% for faq in faqs %}
        <details>
          <summary>
            {{ faq.question }}
          </summary>
          <div class="prose">
            {{ faq.answer|raw }}
          </div>
        </details>
      {% endfor %}
    </div>
  </section>
{% endif %}

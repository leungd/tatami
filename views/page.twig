{% extends 'base.twig' %}

{# The router sets hero_title_tag: 'h1' unless the body carries its own <h1>
   (docs/hero.md). A page template whose <h1> lives outside the body sets it
   to 'p'. #}
{% set hero_title_tag = hero_title_tag|default('p') %}

{% block hero %}
  {% embed 'partials/hero.twig'
    with {
      title,
      hero_title_tag
    }
  %}
    {% block heroBody %}
      {% if hero_title_tag == 'h1' %}
        <h1>{{ title }}</h1>
      {% else %}
        {{ parent() }}
      {% endif %}
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block content %}
  <div class="fluid-grid">
    <div class="col-[content-start/content-end]">
      <div class="prose">
        {{ post.content|raw }}
      </div>
    </div>
  </div>
{% endblock %}
